# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
- id: agent-default-model
  name: "@deepseek-ai/dsh-agent-default-model"
  config:
    provider: deepseek-account
    model: deepseek-flash
    reasoningEffort: low
- id: ui-settings-account
  name: "@deepseek-ai/dsh-client-ui-settings-account"
  config:
    version: 1
    step: done
    purpose: development
    process: detailed
    completion: completed
    usage: detailed
    developerTools: true
- id: ui-chat
  name: "@deepseek-ai/dsh-client-ui-chat"
  config:
    transcriptView: detailed
    performanceUsage: detailed
- id: ui-settings
  name: "@deepseek-ai/dsh-client-ui-settings"
  config:
    enabled: true
- id: browserskill
  name: "@wxg-prc-cpg/browser-skill-dsh-plugin"
  config:
    bskPath: C:\Users\Administrator\.local\bin\bsk.exe
    defaultTimeoutMs: 120000
    maxSessions: 5
    observationEnabled: true
    thumbnailIntervalMs: 1500
    idleIntervalMs: 8000
    lazyTools: true
- id: mnemon-strategy-auto-capture
  disabled: false
- id: permission
  name: "@deepseek-ai/dsh-permission-presets"
  config:
    presets:
      read-only:
        sandbox: read-only
        approval: ask
      workspace-write:
        sandbox: workspace-write
        approval: ask
      danger-full-access:
        sandbox: danger-full-access
        approval: never
    defaultPreset: danger-full-access

# ─────────────────────────────────────────────────────────────────────────────
# 关掉 DSH 界面里的余额挂件（小鲸鱼）。
#
# 原因：桌面上已经在跑同一个挂件的「桌面宠物版」（dsh-whale-pet），
# 而 DSH 窗口右下角也会画出这个挂件。DSH 最大化时两者会叠在同一个角落，
# 看起来像「有两个宠物」。桌面宠物版功能是它的超集（且共用同一份账本/设置/素材），
# 所以这里把 DSH 内的那个关掉。
#
# 想恢复（让 DSH 里也显示挂件）：删掉下面这两行，然后重启 DeepSeek Harness。
#   - id: dsh-whale-widget
#     disabled: true
# ─────────────────────────────────────────────────────────────────────────────
- id: dsh-whale-widget
  disabled: true
- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers: {}

# REA MCP server (morluto/rea, installed 2026-10-14). Tools appear as mcp__rea__<tool>.
- id: rea-mcp
  name: "@deepseek-ai/dsh-mcp-client"
  config:
    serverName: rea
    transport: stdio
    command: 'C:\Users\Administrator\AppData\Local\Doubao\User
      Data\sandbox_runtime\bases\d0ace100fdff5b2d247847aca1e3d83b\node\node.exe'
    args:
      - 'C:\Users\Administrator\AppData\Local\Doubao\User
        Data\sandbox_runtime\bases\d0ace100fdff5b2d247847aca1e3d83b\node\node_modules\rea-agents\scripts\rea.mjs'
      - mcp
